# Enterprise WeCom Digital Employee

# Model + provider connection
AGENTSEEK_MODEL_PROVIDER=openai
AGENTSEEK_MODEL=deepseek-v4-flash-0731

# OpenAI / OpenAI-compatible
AGENTSEEK_API_KEY=
AGENTSEEK_API_BASE=
OPENAI_API_KEY=
OPENAI_API_BASE=
LANGCHAIN_OPENAI_STREAM_CHUNK_TIMEOUT_S=300
# Bound one provider request inside the broader LangGraph turn deadline.
AGENTSEEK_MODEL_REQUEST_TIMEOUT_SECONDS=60
AGENTSEEK_MODEL_MAX_RETRIES=0
# The first observable provider/model callback must start within this window.
# This specifically bounds pre-model middleware/runnable stalls without
# shortening the broader multi-tool LangGraph turn deadline below.
AGENTSEEK_LANGCHAIN_MODEL_START_TIMEOUT_SECONDS=60
# Hard limit for one LangChain/LangGraph turn. Timed-out turns are cancelled so
# the next message in the same employee session can continue.
AGENTSEEK_LANGCHAIN_RUN_TIMEOUT_SECONDS=180

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise_wecom_digital_employee

# Enterprise observability. Local JSONL is safe to enable by default because
# employee identifiers are hashed and sensitive fields are redacted.
AGENTSEEK_ENTERPRISE_EVENTS_ENABLED=true
AGENTSEEK_ENTERPRISE_EVENTS_LOG_PATH=./runtime/enterprise-events.jsonl
AGENTSEEK_ENTERPRISE_EVENTS_MAX_VALUE_CHARS=500
# Optional override; defaults to AGENTSEEK_ENTERPRISE_NAMESPACE_SECRET when empty.
AGENTSEEK_ENTERPRISE_EVENTS_HASH_SECRET=
# Optional Langfuse export. Install/configure the langfuse Python SDK before enabling.
AGENTSEEK_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
AGENTSEEK_LANGFUSE_ENV=production
AGENTSEEK_LANGFUSE_RELEASE=enterprise-wecom-v0.0.8
AGENTSEEK_LANGFUSE_TRACE_NAME=agentseek.enterprise
AGENTSEEK_LANGFUSE_FLUSH=true
AGENTSEEK_LANGFUSE_QUEUE_MAXSIZE=1024
AGENTSEEK_LANGFUSE_SAMPLE_RATE=1.0

# AgentSeek LangChain binding
AGENTSEEK_LANGCHAIN_SPEC=enterprise_wecom_digital_employee.agent:build_spec
AGENTSEEK_STREAM_OUTPUT=true

# Runtime state
AGENTSEEK_MCP_CONFIG_PATH=.agents/mcp.json
# MCP policy + audit. Defaults keep existing read/query tools available.
# Tool patterns use server/tool, server:tool, or wildcards such as gildata_datamap-*/*.
AGENTSEEK_ENTERPRISE_MCP_POLICY_ENABLED=true
AGENTSEEK_ENTERPRISE_MCP_DEFAULT_ACTION=allow
AGENTSEEK_ENTERPRISE_MCP_ALLOWLIST=
AGENTSEEK_ENTERPRISE_MCP_DENYLIST=
AGENTSEEK_ENTERPRISE_MCP_WRITE_TOOLS=
AGENTSEEK_ENTERPRISE_MCP_RISKY_TOOLS=
AGENTSEEK_ENTERPRISE_MCP_CONFIRM_TOOLS=
AGENTSEEK_ENTERPRISE_MCP_REQUIRE_CONFIRMATION=true
AGENTSEEK_ENTERPRISE_MCP_AUDIT_ENABLED=true
AGENTSEEK_ENTERPRISE_MCP_AUDIT_LOG_PATH=./runtime/mcp-audit.jsonl
AGENTSEEK_SCHEDULE_SQLALCHEMY_URL=sqlite+pysqlite:///./runtime/schedule.db
AGENTSEEK_ENTERPRISE_MEMORY_ENABLED=true
# Production option: move short-term memory to PostgreSQL/MySQL via SQLAlchemy.
# Examples:
# AGENTSEEK_ENTERPRISE_MEMORY_SQLALCHEMY_URL=postgresql+psycopg://user:pass@host:5432/agentseek
# AGENTSEEK_ENTERPRISE_MEMORY_SQLALCHEMY_URL=mysql+pymysql://user:pass@host:3306/agentseek?charset=utf8mb4
# Local fallback when AGENTSEEK_ENTERPRISE_MEMORY_SQLALCHEMY_URL is empty:
AGENTSEEK_ENTERPRISE_MEMORY_SQLITE_PATH=./runtime/enterprise-short-term-memory.sqlite3
AGENTSEEK_ENTERPRISE_MEMORY_RECENT_TURNS=8
# Bound prompt injection even when a recent research/tool reply is very large.
AGENTSEEK_ENTERPRISE_MEMORY_PROMPT_MAX_CHARS=12000
AGENTSEEK_ENTERPRISE_MEMORY_PROMPT_MAX_MESSAGE_CHARS=3000
AGENTSEEK_ENTERPRISE_MEMORY_TTL_SECONDS=604800
AGENTSEEK_ENTERPRISE_MEMORY_MAX_CONTENT_CHARS=4000
AGENTSEEK_ENTERPRISE_SERIALIZE_TURNS=true
AGENTSEEK_ENTERPRISE_TENANT_ID=default
# Set a random secret in production so storage namespaces cannot be derived from OA accounts.
AGENTSEEK_ENTERPRISE_NAMESPACE_SECRET=
# Production option: move explicit durable memory to PostgreSQL/MySQL via SQLAlchemy.
# AGENTSEEK_ENTERPRISE_STORE_SQLALCHEMY_URL=postgresql+psycopg://user:pass@host:5432/agentseek
# AGENTSEEK_ENTERPRISE_STORE_SQLALCHEMY_URL=mysql+pymysql://user:pass@host:3306/agentseek?charset=utf8mb4
# Local fallback when AGENTSEEK_ENTERPRISE_STORE_SQLALCHEMY_URL is empty:
AGENTSEEK_ENTERPRISE_STORE_SQLITE_PATH=./runtime/enterprise-long-term-store.sqlite3

# v0.1.0 durable work runtime. Disabled by default until its isolated PostgreSQL
# schema and PackSnapshot storage have been reviewed. Never point this at the
# production ledger with AUTO_MIGRATE=true.
AGENTSEEK_WORK_ENABLED=false
AGENTSEEK_WORK_BINDING=enterprise_wecom_digital_employee.work_composition:build_work_binding
AGENTSEEK_WORK_SQLALCHEMY_URL=
AGENTSEEK_WORK_AUTO_MIGRATE=false
AGENTSEEK_WORK_SNAPSHOT_PATH=./runtime/work-pack-snapshots
AGENTSEEK_WORK_TEMPLATE_ASSET_PATH=./digital_employees/industry-report/assets/neutral-industry-report-v1.docx
AGENTSEEK_WORK_ARTIFACT_PATH=./runtime/work-artifacts
AGENTSEEK_WORK_RUNTIME_RELEASE=enterprise-wecom-v0.1.0-m1
AGENTSEEK_WORK_SOURCE_REPOSITORY=
AGENTSEEK_WORK_SOURCE_COMMIT=

# ContextSeek semantic memory. v0.0.7 production uses PostgreSQL + pgvector.
# The semantic layer only starts after enterprise identity resolution succeeds.
# Use bge-m3 dense embeddings (1024 dims) exported to ONNX and loaded with onnxruntime.
# v0.0.7 starts with a fresh pgvector table; do not migrate SeekDB data directly.
AGENTSEEK_CTX_STORAGE_BACKEND=pgvector
AGENTSEEK_CTX_PGVECTOR_URL=postgresql+psycopg://agentseek_app:<password>@localhost/agentseek
AGENTSEEK_CTX_PGVECTOR_TABLE=contextseek_pgvector_items
AGENTSEEK_CTX_PGVECTOR_DIMS=1024
AGENTSEEK_CTX_BGE_M3_ONNX_MODEL_PATH=./models/bge-m3-onnx/model.onnx
AGENTSEEK_CTX_BGE_M3_TOKENIZER_PATH=./models/bge-m3-onnx/tokenizer.json
AGENTSEEK_CTX_BGE_M3_MAX_LENGTH=8192
AGENTSEEK_CTX_TENANT=default
AGENTSEEK_CTX_SCOPE_MODE=enterprise_user
AGENTSEEK_CTX_INJECTION_MODE=state
AGENTSEEK_CTX_RETRIEVAL_DEFAULT_K=5
# SeekDB hybrid FTS requires exact phrases; use vector-only recall for chat turns.
AGENTSEEK_CTX_RETRIEVAL_RECALL_ROUTES=["vector"]
AGENTSEEK_CTX_STORE_USER_TURNS=true
AGENTSEEK_CTX_STORE_MAX_CONTENT_CHARS=4000
AGENTSEEK_CTX_SKIP_SENSITIVE_CONTENT=true
# Keep local development deterministic and avoid a second LLM call.
AGENTSEEK_CTX_EVOLUTION_ENABLED=false
AGENTSEEK_CTX_LLM_PROVIDER=none
# Local development or rollback option: SeekDB on the local filesystem.
# AGENTSEEK_CTX_STORAGE_BACKEND=seekdb
# AGENTSEEK_CTX_SEEKDB_PATH=./runtime/contextseek
# Use memory temporarily if pgvector setup blocks service continuity.
# AGENTSEEK_CTX_STORAGE_BACKEND=memory

# Strategic Development Department knowledge MCP simulator. This is a separate
# collection from employee ContextSeek memory and accepts only admin imports.
# PostgreSQL must already have both vector and pg_trgm extensions installed.
AGENTSEEK_DEPARTMENT_KNOWLEDGE_POSTGRES_URL=postgresql+psycopg://agentseek_app:<password>@localhost/agentseek
AGENTSEEK_DEPARTMENT_KNOWLEDGE_TENANT_ID=strategic-development
AGENTSEEK_DEPARTMENT_KNOWLEDGE_COLLECTION_ID=strategic-development
AGENTSEEK_DEPARTMENT_KNOWLEDGE_OWNING_ORG=战略发展部
AGENTSEEK_DEPARTMENT_KNOWLEDGE_TABLE_PREFIX=department_knowledge
AGENTSEEK_DEPARTMENT_KNOWLEDGE_DIMS=1024
# Empty values reuse the ContextSeek bge-m3 ONNX paths above.
AGENTSEEK_DEPARTMENT_KNOWLEDGE_ONNX_MODEL_PATH=
AGENTSEEK_DEPARTMENT_KNOWLEDGE_TOKENIZER_PATH=
AGENTSEEK_DEPARTMENT_KNOWLEDGE_CHUNK_CHARS=1200
AGENTSEEK_DEPARTMENT_KNOWLEDGE_CHUNK_OVERLAP_CHARS=150
AGENTSEEK_DEPARTMENT_KNOWLEDGE_KEYWORD_THRESHOLD=0.08
AGENTSEEK_DEPARTMENT_KNOWLEDGE_CREATE_HNSW_INDEX=true

# Inbound file intake. Files are stored under tenant/employee/session scoped
# hashed directories and only extracted text is shown to the model.
AGENTSEEK_FILES_ENABLED=true
AGENTSEEK_FILES_DIR=./runtime/files
AGENTSEEK_FILES_MAX_BYTES=10485760
AGENTSEEK_FILES_ALLOWED_EXTENSIONS=.txt,.md,.csv,.json,.pdf,.docx,.pptx,.xlsx,.png,.jpg,.jpeg,.gif,.bmp,.webp,.amr,.mp4,.mp3,.wav,.m4a
AGENTSEEK_FILES_EXTRACTOR=mineru
AGENTSEEK_FILES_EXTRACT_MAX_CHARS=12000
AGENTSEEK_FILES_RETENTION_DAYS=7
AGENTSEEK_FILES_NOTIFY_ON_DONE=true
# Run a non-blocking full OCR pass when a PDF has both text and image-only pages.
AGENTSEEK_FILES_MIXED_PDF_BG_OCR=true

# MinerU remote document/image extraction. Local text files are extracted
# directly; PDF/Office/image files use MinerU when AGENTSEEK_FILES_EXTRACTOR=mineru.
AGENTSEEK_MINERU_BASE_URL=https://mineru.net
AGENTSEEK_MINERU_TOKEN=
AGENTSEEK_MINERU_MODEL_VERSION=vlm
AGENTSEEK_MINERU_OCR_MODEL_VERSION=pipeline
AGENTSEEK_MINERU_LANGUAGE=ch
AGENTSEEK_MINERU_ENABLE_TABLE=true
AGENTSEEK_MINERU_ENABLE_FORMULA=true
# false: auto-detect (fast non-OCR first, one OCR retry for scanned PDFs).
# true: force OCR immediately using AGENTSEEK_MINERU_OCR_MODEL_VERSION.
AGENTSEEK_MINERU_IS_OCR=false
AGENTSEEK_MINERU_POLL_TIMEOUT_S=300
AGENTSEEK_MINERU_POLL_INTERVAL_S=2

# WeCom intelligent robot callback
AGENTSEEK_WECOM_ENABLED=true
AGENTSEEK_WECOM_TRANSPORT_MODE=callback
AGENTSEEK_WECOM_HOST=0.0.0.0
AGENTSEEK_WECOM_PORT=12000
AGENTSEEK_WECOM_CALLBACK_PATH=/ai-bot/callback/demo/<botid>
AGENTSEEK_WECOM_TOKEN=
AGENTSEEK_WECOM_ENCODING_AES_KEY=
AGENTSEEK_WECOM_RECEIVE_ID=

# M0.5 alternative to Callback. The WeCom admin console allows exactly one
# mode per AI Bot. Keep TRANSPORT_MODE=callback until the dedicated switch
# window, then set long_connection and provide its separate BotID/Secret.
# AGENTSEEK_WECOM_TRANSPORT_MODE=long_connection
# AGENTSEEK_WECOM_LONG_CONNECTION_BOT_ID=
# AGENTSEEK_WECOM_LONG_CONNECTION_SECRET=
AGENTSEEK_WECOM_LONG_CONNECTION_URL=wss://openws.work.weixin.qq.com
AGENTSEEK_WECOM_LONG_CONNECTION_HEARTBEAT_SECONDS=30
AGENTSEEK_WECOM_LONG_CONNECTION_COMMAND_TIMEOUT_SECONDS=10
AGENTSEEK_WECOM_LONG_CONNECTION_RECONNECT_MIN_SECONDS=1
AGENTSEEK_WECOM_LONG_CONNECTION_RECONNECT_MAX_SECONDS=30
AGENTSEEK_WECOM_LONG_CONNECTION_STREAM_INTERVAL_SECONDS=3
AGENTSEEK_WECOM_LONG_CONNECTION_LOCK_PATH=runtime/wecom-long-connection.lock

# Existing helper app used only for encrypted robot open_userid -> plaintext userid.
# This Secret is not the M0.6 shared notification application's Secret.
AGENTSEEK_WECOM_CORP_ID=
AGENTSEEK_WECOM_APP_SECRET=
AGENTSEEK_WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
AGENTSEEK_WECOM_USERID_RESOLVE_MODE=openuserid_to_userid
AGENTSEEK_WECOM_USERID_CACHE_TTL_SECONDS=3600

# M0.6 supplementary self-built application Transport. It can coexist with
# either AI Bot callback or long_connection; it is not a third Bot mode.
# Keep disabled until the Linux static gates pass and an administrator creates
# the common application with a deliberately limited visible scope.
AGENTSEEK_WECOM_APP_TRANSPORT_ENABLED=false
AGENTSEEK_WECOM_APP_AGENT_ID=
AGENTSEEK_WECOM_APP_TRANSPORT_SECRET=
AGENTSEEK_WECOM_APP_CALLBACK_PATH=/wecom/app/callback
AGENTSEEK_WECOM_APP_CALLBACK_TOKEN=
AGENTSEEK_WECOM_APP_CALLBACK_ENCODING_AES_KEY=
# Every outbound message must declare one of these business sources. The
# physical application AgentID never substitutes for digital_employee_id.
AGENTSEEK_WECOM_APP_ALLOWED_DIGITAL_EMPLOYEE_IDS=industry-report
AGENTSEEK_WECOM_APP_DEFAULT_DIGITAL_EMPLOYEE_ID=industry-report
AGENTSEEK_WECOM_APP_VISIBILITY_CACHE_TTL_SECONDS=300
# M0.6 live verification only. The exact trigger arrives through the AI Bot;
# the common app then targets one visible member and optional department/tag.
# Clear all five fields after verification.
AGENTSEEK_WECOM_APP_PROACTIVE_PROBE_TRIGGER=
AGENTSEEK_WECOM_APP_PROACTIVE_PROBE_USERID=
AGENTSEEK_WECOM_APP_PROACTIVE_PROBE_PARTY_ID=
AGENTSEEK_WECOM_APP_PROACTIVE_PROBE_TAG_ID=
AGENTSEEK_WECOM_APP_PROACTIVE_PROBE_FILE_PATH=
# Legacy callbacks without response_url wait briefly for their first stream update.
AGENTSEEK_WECOM_INITIAL_WAIT_SECONDS=0.5
# Same employee/session messages are processed in arrival order. Keep this
# slightly above the model timeout so the channel can publish its timeout reply.
AGENTSEEK_WECOM_TURN_TIMEOUT_SECONDS=195
# Pending capacity excludes the active turn. Overflow receives a terminal
# rejection and never enters the Agent; size burst-test headroom deliberately.
AGENTSEEK_WECOM_SESSION_QUEUE_MAXSIZE=3
AGENTSEEK_WECOM_QUEUE_WAIT_TIMEOUT_SECONDS=240
AGENTSEEK_WECOM_SHUTDOWN_TIMEOUT_SECONDS=10
# M0.3 defaults to process-local compatibility mode. Set sqlite explicitly only
# after creating a dedicated high-entropy secret that remains stable on restart.
AGENTSEEK_WECOM_DURABLE_MODE=memory
AGENTSEEK_WECOM_DURABLE_SQLITE_PATH=runtime/wecom-messages.sqlite3
AGENTSEEK_WECOM_DURABLE_SECRET=
AGENTSEEK_WECOM_DURABLE_RECOVERY_LIMIT=100
AGENTSEEK_WECOM_DURABLE_RECOVERY_INTERVAL_SECONDS=30
AGENTSEEK_WECOM_DURABLE_LEASE_SECONDS=600
# M4-00 live verification only. Keep empty during normal operation.
AGENTSEEK_WECOM_RESPONSE_URL_TEMPLATE_CARD_PROBE_TRIGGER=
# M0.4 live verification only. Sends one button card whose click returns a card event.
AGENTSEEK_WECOM_TEMPLATE_CARD_EVENT_PROBE_TRIGGER=
# M0.5 long-connection live verification only. Sends proactive Markdown + button card.
AGENTSEEK_WECOM_LONG_CONNECTION_PROACTIVE_PROBE_TRIGGER=

# AI Bot callback response_url supports markdown/template_card, not file.
# M4 will use a short-lived signed HTTPS download link without switching transports.
AGENTSEEK_WORK_ARTIFACT_DELIVERY_MODE=disabled
# AGENTSEEK_WORK_ARTIFACT_PUBLIC_BASE_URL=https://reports.example.com/artifacts
# AGENTSEEK_WORK_ARTIFACT_GRANT_TTL_SECONDS=3600

# Enterprise employee identity
AGENTSEEK_IDENTITY_PROVIDER=dm
AGENTSEEK_IDENTITY_DM_HOST=
AGENTSEEK_IDENTITY_DM_PORT=5236
AGENTSEEK_IDENTITY_DM_USER=
AGENTSEEK_IDENTITY_DM_PASSWORD=
AGENTSEEK_IDENTITY_DM_SCHEMA=DBO
AGENTSEEK_IDENTITY_DM_DRIVER_MODULE=agentseek_enterprise.identity.jdbc_driver
AGENTSEEK_IDENTITY_DM_PARAMSTYLE=qmark
# Stable one-shot isolation: subprocess. Gray-box test long-lived worker: sidecar.
AGENTSEEK_IDENTITY_DM_EXECUTION_MODE=subprocess
# AGENTSEEK_IDENTITY_DM_EXECUTION_MODE=sidecar
AGENTSEEK_IDENTITY_DM_SUBPROCESS_TIMEOUT_SECONDS=30
AGENTSEEK_IDENTITY_DM_SIDECAR_TIMEOUT_SECONDS=8
AGENTSEEK_ENTERPRISE_IDENTITY_LOOKUP_TIMEOUT_SECONDS=15
AGENTSEEK_ENTERPRISE_IDENTITY_CACHE_ENABLED=true
AGENTSEEK_ENTERPRISE_IDENTITY_CACHE_TTL_SECONDS=600
AGENTSEEK_ENTERPRISE_IDENTITY_CACHE_MAX_ENTRIES=1024
AGENTSEEK_IDENTITY_DM_JDBC_JAR=vendor/dameng/DmJdbcDriver18-8.1.3.62.jar
AGENTSEEK_IDENTITY_DM_JDBC_CLASS=dm.jdbc.driver.DmDriver
# JPype + DM JDBC is verified with Java 11 on macOS arm64.
AGENTSEEK_IDENTITY_DM_JDBC_JAVA_HOME=/opt/homebrew/opt/openjdk@11/libexec/openjdk.jdk/Contents/Home

# Linux/Windows deployments with the official native DM client may use dmPython:
# AGENTSEEK_IDENTITY_DM_DRIVER_MODULE=dmPython
